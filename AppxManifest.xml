<?xml version="1.0" encoding="utf-8"?>
<!-- Шаблон манифеста MSIX. {{VERSION}} и {{PUBLISHER}} подставляет package.ps1. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity Name="Nochnik" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Ночник</DisplayName>
    <PublisherDisplayName>Nochnik</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="Night" Executable="Night.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Ночник"
                          Description="Тёплый свет для экрана: гамма и прозрачная плёнка, подсветку монитора не трогает."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Запись в HKCU\...\Run внутри пакета виртуализуется, поэтому автозапуск — задача запуска. -->
        <desktop:Extension Category="windows.startupTask" Executable="Night.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="NightStartup" Enabled="false" DisplayName="Ночник" />
        </desktop:Extension>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="Night.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="night.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
