#pragma code_page(65001)
#include <winuser.h>
#include <winver.h>
#include "version.h"

1 ICON "assets\\night.ico"
1 RT_MANIFEST "app.manifest"
101 RCDATA "assets\\fonts\\Onest-Regular.ttf"
102 RCDATA "assets\\fonts\\Onest-Bold.ttf"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NIGHT_VER_MAJOR, NIGHT_VER_MINOR, NIGHT_VER_PATCH, NIGHT_VER_BUILD
 PRODUCTVERSION NIGHT_VER_MAJOR, NIGHT_VER_MINOR, NIGHT_VER_PATCH, NIGHT_VER_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904b0"
        BEGIN
            VALUE "FileDescription", "Ночник"
            VALUE "ProductName", "Ночник"
            VALUE "FileVersion", NIGHT_VER_STR
            VALUE "ProductVersion", NIGHT_VER_STR
            VALUE "OriginalFilename", "Night.exe"
            VALUE "InternalName", "Night"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
